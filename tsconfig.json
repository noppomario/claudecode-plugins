{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "claude-code": [
        "./.claude/types/claude-code.d.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "plugins/*/hooks/**/*.ts",
    "plugins/*/tests/**/*.ts",
    ".claude/types/claude-code.d.ts"
  ],
  "exclude": [
    "**/vendor/zombie-*.mjs",
    "node_modules"
  ]
}
